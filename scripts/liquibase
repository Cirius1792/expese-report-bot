#!/bin/sh
# Project wrapper for the Liquibase CLI (ADR 0013).
#
# Runs the official Liquibase 4.33.0 Docker image, which bundles the SQLite
# JDBC driver — no driver jars are committed to the repo and no `--classpath`
# is needed. (Liquibase 5.x dropped bundled drivers and relies on the
# unreliable `lpm` package manager; see ADR 0013.)
#
# Used by the test suite, BDD scenarios, the expense-extract CLI, and local
# development — no CLI install required.
#
# Contract (mirrors the real CLI):
#   liquibase update --url=jdbc:sqlite:<path> --changelog-file=db/changelog/db.changelog.xml
#
# The subcommand and --changelog-file are taken from the caller's arguments, so
# this wrapper cannot silently drift from the call sites that pass them.
set -u

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# Resolve repo root: prefer explicit env var, then CWD, then script's parent.
if [ -n "${LIQUIBASE_REPO_ROOT:-}" ]; then
    REPO_ROOT="$LIQUIBASE_REPO_ROOT"
elif [ -f "$(pwd)/db/changelog/db.changelog.xml" ]; then
    REPO_ROOT=$(pwd)
else
    REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
fi

# Parse the caller's arguments instead of hardcoding the subcommand/changelog.
DB_URL=""
CHANGELOG="db/changelog/db.changelog.xml"
ACTION="update"
for arg in "$@"; do
    case "$arg" in
        --url=*) DB_URL="${arg#--url=}" ;;
        --changelog-file=*) CHANGELOG="${arg#--changelog-file=}" ;;
        -*) ;;                       # every other flag is ignored, as before
        *) ACTION="$arg" ;;
    esac
done

case "$DB_URL" in
    jdbc:sqlite:*) DB_PATH="${DB_URL#jdbc:sqlite:}" ;;
    *)
        echo "liquibase wrapper: only --url=jdbc:sqlite:<path> is supported" >&2
        exit 2
        ;;
esac
if [ -z "$DB_PATH" ]; then
    echo "liquibase wrapper: --url=jdbc:sqlite:<path> requires a non-empty path" >&2
    exit 2
fi

NAME=$(basename "$DB_PATH")
STAGE="${LIQUIBASE_SHIM_DIR:-/tmp/liquibase-shim}"
mkdir -p "$STAGE"
# Private staging directory: the database copy is only readable/writable by the
# current user, so another local user cannot read or tamper with it. The
# container is run as this same user (with the image's `liquibase` group added
# so it can still execute the CLI), so no world-writable permissions are needed.
chmod 700 "$STAGE" 2>/dev/null || true
rm -f "$STAGE/$NAME"
if [ -f "$DB_PATH" ]; then
    if ! cp "$DB_PATH" "$STAGE/$NAME"; then
        echo "liquibase wrapper: failed to stage $DB_PATH into $STAGE" >&2
        exit 1
    fi
else
    if ! : > "$STAGE/$NAME"; then
        echo "liquibase wrapper: failed to create $STAGE/$NAME" >&2
        exit 1
    fi
fi
chmod 600 "$STAGE/$NAME" 2>/dev/null || true

IMAGE="${LIQUIBASE_IMAGE:-liquibase/liquibase:4.33.0}"
# The DB filename/changelog/action are passed as environment variables so the
# container's `sh -c` script never interpolates them: a filename containing
# spaces or shell metacharacters cannot break out and execute commands.
docker run --rm \
    --user "$(id -u):$(id -g)" \
    --group-add liquibase \
    -e "LIQUIBASE_DB_FILE=$NAME" \
    -e "LIQUIBASE_CHANGELOG=$CHANGELOG" \
    -e "LIQUIBASE_ACTION=$ACTION" \
    -v "$STAGE":/dbshim \
    -v "$REPO_ROOT":/work:ro \
    --entrypoint sh \
    "$IMAGE" \
    -c 'liquibase --validate-xml-changelog-files=false --searchPath=/work "$LIQUIBASE_ACTION" --url="jdbc:sqlite:/dbshim/$LIQUIBASE_DB_FILE" --changelog-file="$LIQUIBASE_CHANGELOG"'
rc=$?

# Copy the migrated database back even on failure (Liquibase is transactional,
# so the staged file stays consistent), but never swallow an error: a silent
# copy-back failure would leave the caller believing the DB was updated.
if ! cp -f "$STAGE/$NAME" "$DB_PATH"; then
    echo "liquibase wrapper: failed to write migrated database back to $DB_PATH" >&2
    exit 1
fi
exit $rc
